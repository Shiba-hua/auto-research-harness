#!/usr/bin/env bash
# 值班员：MiniCPM5-2B（llama.cpp）。
# 不带参数 = CPU 常驻；--gpu N = 整体卸载到第 N 张卡。
set -uo pipefail
D=/root/dsh-harness
M=${GUARD_MODEL:-/dev/shm/models/mcpm5-2b-gguf/MiniCPM5-2B-Q4_K_M.gguf}
PORT=${GUARD_PORT:-18099}
THREADS=${GUARD_THREADS:-12}
CTX=${GUARD_CTX:-32768}
BIN=$D/build/llama.cpp/build-cpu/bin/llama-server
NGL=0; DEV=""
while [ $# -gt 0 ]; do
  case "$1" in
    --gpu) BIN=$D/build/llama.cpp/build-cuda/bin/llama-server; NGL=999; DEV="CUDA$2"; shift 2;;
    *) shift;;
  esac
done
echo "mode=$([ "$NGL" = 0 ] && echo CPU || echo "GPU:$DEV") bin=$(basename $BIN)"
if [ "$NGL" = "0" ]; then
  exec $D/bin/guest "$BIN" -m "$M" --host 127.0.0.1 --port "$PORT" \
    -t "$THREADS" -c "$CTX" --jinja -fa on -ngl 0 --alias minicpm5-2b
else
  exec $D/bin/guest "$BIN" -m "$M" --host 127.0.0.1 --port "$PORT" \
    -t "$THREADS" -c "$CTX" --jinja -fa on -ngl "$NGL" --device "$DEV" --alias minicpm5-2b
fi
