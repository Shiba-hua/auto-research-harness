#!/usr/bin/env bash
# DSH 上线器（在 PRoot guest 内跑，提供 glibc 2.35 给 sharp/node-pty）
# 关键：必须把宿主 /root/.dsh 挂进 guest，否则 DSH 读的是 guest 自己的空 DSH_HOME，
# 用户补丁层 cordis.patch.yml 会被完全忽略（dump-config 与 dump-default-config 零差异）。
set -euo pipefail
D=/root/dsh-harness
export GR_EXTRA_BIND="/root/.dsh:/root/.dsh"
exec $D/bin/guest /opt/node24/bin/dsh "$@"
